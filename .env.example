# Xalterra deployment — example environment file.
# Copy to .env and fill in real values there. Never commit .env.
#
# See docs/environment-variables.md for the full list (HTTP auth, caching,
# method allowlist, MRTR signing key, etc.) — this file only covers the
# three variables every deployment needs.

# ERPNext/Frappe site root (no trailing slash, no /desk or /api suffix).
# Xalterra's instance: https://core.apps.xalterra.com
ERPNEXT_URL=

# API key/secret for a dedicated, least-privilege ERPNext service user.
# Never use the Administrator account here.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
